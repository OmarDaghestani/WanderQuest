NODE_ENV=development
PORT=5000

# Required: the server refuses to start without it
JWT_SECRET=

# Development database
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Production database (used when NODE_ENV=production)
DATABASE_URL=

GOOGLE_PLACES_API_KEY=
OPENWEATHER_API_KEY=

# Extra allowed frontend origins, comma-separated (production origin is built in)
CLIENT_URL=
